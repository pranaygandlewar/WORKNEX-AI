# =================================================================
# WORKNEX AI — Environment Configuration
# =================================================================

# Security & Session Keys
SECRET_KEY=worknex-enterprise-secret-key-super-secure-change-in-prod-2026
MCP_API_KEY=your_secret_mcp_api_key_here
ADMIN_API_KEY=your_secret_admin_key_here

# Database Configuration (PostgreSQL)
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password
POSTGRES_DB=erp_lite
DATABASE_URL=postgresql://erp_user:erp_password@localhost:15432/erp_lite

# MCP Server Binding
MCP_HOST=127.0.0.1
MCP_PORT=8000

# AI Provider Configuration
# Options: 'gemini', 'openai', or 'mock' (heuristic engine)
AI_PROVIDER=mock
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Environment (Vite)
VITE_API_URL=http://localhost:8000/api/v1
